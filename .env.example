NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_MODE=mock
MIN_CONTRIBUTION_PAISE=10000
MAX_CONTRIBUTION_PAISE=10000000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Random secret, at least 32 characters. Used to hash trusted proxy IPs for DB rate limits.
RATE_LIMIT_SECRET=
# Set vercel only when actually running behind Vercel's trusted proxy.
TRUSTED_PROXY=none
DEMO_OWNER_USER_ID=
# Demo owner must additionally have app_metadata.shagun_demo=true, set by an operator.
# Connected acceptance: use a dedicated test project and two existing, confirmed
# Email/password Auth users without wedding profiles. Store passwords only locally.
E2E_CONNECTED=0
E2E_ISOLATED_PROJECT=0
E2E_OWNER_A_EMAIL=
E2E_OWNER_A_PASSWORD=
E2E_OWNER_B_EMAIL=
E2E_OWNER_B_PASSWORD=
# Optional already-running app origin; never point at live payment infrastructure.
E2E_BASE_URL=
# Optional LOCAL PostgreSQL admin connection for disposable independent-connection tests.
TEST_PG_ADMIN_URL=postgres://shagun_test@127.0.0.1:55439/postgres
