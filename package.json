    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
